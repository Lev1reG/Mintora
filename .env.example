# Database
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=mintora

# Queue
RABBITMQ_URI=amqp://localhost:5672
RABBITMQ_QUEUE_MESSAGES=messages.incoming

# Auth
